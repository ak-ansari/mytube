    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Debug API",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/api/main.go",
            "cwd": "${workspaceFolder}",
            "args":["-config","${workspaceFolder}/internal/config/config.yaml"]

        },
        {
            "name": "Debug Worker",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/worker/main.go",
            "cwd": "${workspaceFolder}",
            "args":["-config","${workspaceFolder}/internal/config/config.yaml"]

        }
    ]
}